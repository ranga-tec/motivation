{
  "UseSQLite": true,
  "SeedDemoUsers": true,
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=poms-api-local.db"
  },
  "ApiAuthentication": {
    "Authority": "https://identity.example.invalid",
    "Audience": "poms-api",
    "RequireHttpsMetadata": true,
    "NameClaimType": "name",
    "RoleClaimType": "poms_role"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "FileStorage": {
    "RootPath": "PomsStorage",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".docx" ]
  },
  "AllowedHosts": "*"
}
