@using Poms.Web.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-page">
<header class="page-header-professional">
    <div>
        <span class="page-eyebrow">Operations overview</span>
        <h1>Dashboard</h1>
        <p>Today’s appointments, active patient records, and frequently used actions.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Patients" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-user-plus me-1" aria-hidden="true"></i> Register patient
        </a>
    </div>
</header>

<section class="metric-grid mb-4" aria-label="Service overview">
    <a asp-controller="Patients" asp-action="Index" class="metric-card">
        <span class="metric-card-label"><i class="fa-solid fa-users" aria-hidden="true"></i> Total patients</span>
        <strong class="metric-card-value">@ViewBag.TotalPatients</strong>
        <span class="metric-card-detail">View patient directory</span>
    </a>
    <a asp-controller="Home" asp-action="ActiveRecordsDrillDown" class="metric-card">
        <span class="metric-card-label"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Active records</span>
        <strong class="metric-card-value">@ViewBag.ActiveRecords</strong>
        <span class="metric-card-detail">Open clinical workload</span>
    </a>
    <div class="metric-card">
        <span class="metric-card-label"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Active patients</span>
        <strong class="metric-card-value">@ViewBag.ActivePatients</strong>
        <span class="metric-card-detail">Currently receiving care</span>
    </div>
    <div class="metric-card">
        <span class="metric-card-label"><i class="fa-solid fa-calendar-day" aria-hidden="true"></i> Today’s activity</span>
        <strong class="metric-card-value">@((int)ViewBag.TodaysAssessments + (int)ViewBag.TodaysFittings + (int)ViewBag.TodaysDeliveries)</strong>
        <span class="metric-card-detail">@ViewBag.TodaysAssessments assessments · @ViewBag.TodaysFittings fittings · @ViewBag.TodaysDeliveries deliveries</span>
    </div>
</section>

<section class="surface-card mb-4">
    <div class="surface-card-header">
        <div><span class="page-eyebrow">Today</span><h2>Appointments and scheduled actions</h2></div>
        <div>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary">View Appointments</a>
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-primary">+ New Appointment</a>
        </div>
    </div>
    <div class="p-0">
        @{
            var todaysAppointments = ViewBag.TodaysAppointments as IEnumerable<Poms.Domain.Entities.Appointment>;
        }
        @if (todaysAppointments != null && todaysAppointments.Any())
        {
            <table class="table table-sm">
                <thead><tr><th>Time</th><th>Patient</th><th>Type</th><th>Prosthetist / Orthotist</th></tr></thead>
                <tbody>
                    @foreach (var a in todaysAppointments)
                    {
                        <tr>
                            <td>@a.AppointmentTime</td>
                            <td>@a.Patient.PatientNumber - @a.Patient.FullName</td>
                            <td>
                                @(a.Type == Poms.Domain.Enums.AppointmentType.FollowUp
                                    ? "Follow-up"
                                    : a.Type == Poms.Domain.Enums.AppointmentType.GaitTraining
                                        ? "Gait training"
                                        : a.Type.ToString())
                            </td>
                            <td>@(a.AssignedClinicianName ?? "Not assigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i>No appointments scheduled for today.</div>
        }
    </div>
</section>

<div class="dashboard-layout">
    <section class="surface-card">
            <div class="surface-card-header"><h2>Quick actions</h2></div>
            <div class="p-3 quick-action-list">
                <a asp-controller="Episodes" asp-action="Create" class="quick-action-primary"><span><i class="fa-solid fa-notes-medical me-2" aria-hidden="true"></i>Create clinical record</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                <a asp-controller="Appointments" asp-action="Create" class="quick-action-primary"><span><i class="fa-regular fa-calendar-plus me-2" aria-hidden="true"></i>Schedule appointment</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>

                @{
                    var quickActionPatients = ViewBag.Patients as SelectList;
                }
                <datalist id="quickActionPatients">
                    @foreach (var patient in quickActionPatients!)
                    {
                        <option value="@patient.Text" data-patient-id="@patient.Value"></option>
                    }
                </datalist>
                <form asp-controller="Fittings" asp-action="QuickAdd" method="get" class="input-group mb-2" data-patient-quick-action>
                    <input type="search"
                           class="form-control"
                           list="quickActionPatients"
                           placeholder="Add Fitting for…"
                           aria-label="Search patient for fitting"
                           autocomplete="off"
                           data-patient-search
                           required />
                    <input type="hidden" name="patientId" data-patient-id />
                    <button type="submit" class="btn btn-outline-success">Go</button>
                </form>
                <form asp-controller="Deliveries" asp-action="QuickAdd" method="get" class="input-group mb-2" data-patient-quick-action>
                    <input type="search"
                           class="form-control"
                           list="quickActionPatients"
                           placeholder="Add Delivery for…"
                           aria-label="Search patient for delivery"
                           autocomplete="off"
                           data-patient-search
                           required />
                    <input type="hidden" name="patientId" data-patient-id />
                    <button type="submit" class="btn btn-outline-info">Go</button>
                </form>
                <form asp-controller="FollowUps" asp-action="QuickAdd" method="get" class="input-group mb-2" data-patient-quick-action>
                    <input type="search"
                           class="form-control"
                           list="quickActionPatients"
                           placeholder="Add Follow-up for…"
                           aria-label="Search patient for follow-up"
                           autocomplete="off"
                           data-patient-search
                           required />
                    <input type="hidden" name="patientId" data-patient-id />
                    <button type="submit" class="btn btn-outline-warning">Go</button>
                </form>
            </div>
    </section>
    <section class="surface-card">
            <div class="surface-card-header"><h2>Recent activity</h2></div>
            <div style="max-height: 420px; overflow-y: auto;">
                @{
                    var recent = ViewBag.RecentActivities as List<RecentActivityItem>;
                }
                @if (recent != null && recent.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Patient</th><th>Activity</th><th>User</th><th>Location</th></tr></thead>
                        <tbody>
                            @foreach (var item in recent)
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd-MMM HH:mm")</td>
                                    <td>@item.PatientNumber<br /><small class="text-muted">@item.PatientName</small></td>
                                    <td>@item.ActivityType</td>
                                    <td>@item.User</td>
                                    <td>@item.Location</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>No recent activity.</div>
                }
            </div>
    </section>
</div>
</div>

@section Scripts {
    <script>
        (() => {
            const options = [...document.querySelectorAll("#quickActionPatients option")];

            document.querySelectorAll("[data-patient-quick-action]").forEach(form => {
                const search = form.querySelector("[data-patient-search]");
                const patientId = form.querySelector("[data-patient-id]");

                const syncPatient = () => {
                    const entered = search.value.trim();
                    const match = options.find(option =>
                        option.value.localeCompare(entered, undefined, { sensitivity: "accent" }) === 0);
                    patientId.value = match?.dataset.patientId || "";
                    search.setCustomValidity(
                        entered && !match ? "Select a patient from the search results." : "");
                };

                search.addEventListener("input", syncPatient);
                search.addEventListener("change", syncPatient);
                form.addEventListener("submit", event => {
                    syncPatient();
                    if (!patientId.value) {
                        event.preventDefault();
                        search.setCustomValidity("Search for and select a patient.");
                        search.reportValidity();
                    }
                });
            });
        })();
    </script>
}
