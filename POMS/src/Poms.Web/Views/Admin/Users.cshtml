@model Poms.Web.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "User access";
    var activeUsers = Model.Users.Count(user => !user.IsLocked);
    var administrators = Model.Users.Count(user => user.Roles.Contains("ADMIN"));
    var restrictedUsers = Model.Users.Count(user =>
        user.CanAccessRestrictedClinicalData || user.Roles.Contains("ADMIN"));
}

<div class="admin-page">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-3">
            <li class="breadcrumb-item"><a asp-action="Index">Administration</a></li>
            <li class="breadcrumb-item active" aria-current="page">User access</li>
        </ol>
    </nav>

    <header class="page-header mb-4">
        <div>
            <span class="page-eyebrow">Identity &amp; access</span>
            <h1 class="h2 mb-2">User access management</h1>
            <p class="text-body-secondary mb-0">
                Create staff accounts, assign least-privilege roles, and control sign-in access.
            </p>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse"
                data-bs-target="#createUserPanel" aria-expanded="@(!ViewData.ModelState.IsValid ? "true" : "false")"
                aria-controls="createUserPanel">
            <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create user
        </button>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section id="createUserPanel"
             class="collapse @(!ViewData.ModelState.IsValid ? "show" : null) mb-4"
             aria-labelledby="createUserHeading">
        <div class="card admin-create-card">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <span class="admin-section-icon" aria-hidden="true">
                            <i class="fa-solid fa-user-shield"></i>
                        </span>
                        <h2 id="createUserHeading" class="h4 mt-3">Create a staff account</h2>
                        <p class="text-body-secondary mb-0">
                            Use the staff member's work email and share the temporary password securely.
                            They can change it from their account page after signing in.
                        </p>
                    </div>
                    <div class="col-lg-8">
                        <form asp-action="UserCreate" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label asp-for="NewUser.FullName" class="form-label"></label>
                                    <input asp-for="NewUser.FullName" class="form-control" autocomplete="name" />
                                    <span asp-validation-for="NewUser.FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewUser.EmployeeNumber" class="form-label"></label>
                                    <input asp-for="NewUser.EmployeeNumber" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="NewUser.EmployeeNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.Designation" class="form-label"></label>
                                    <input asp-for="NewUser.Designation"
                                           class="form-control"
                                           type="search"
                                           list="staffDesignationOptions"
                                           autocomplete="off"
                                           placeholder="Select or type a designation" />
                                    <div class="form-text">Choose a clinical designation or enter another staff role.</div>
                                    <span asp-validation-for="NewUser.Designation" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.Department" class="form-label"></label>
                                    <input asp-for="NewUser.Department" class="form-control" />
                                    <span asp-validation-for="NewUser.Department" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.MobileNumber" class="form-label"></label>
                                    <input asp-for="NewUser.MobileNumber" class="form-control" autocomplete="tel" />
                                    <span asp-validation-for="NewUser.MobileNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.WorkPhoneNumber" class="form-label"></label>
                                    <input asp-for="NewUser.WorkPhoneNumber" class="form-control" autocomplete="tel" />
                                    <span asp-validation-for="NewUser.WorkPhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.Email" class="form-label"></label>
                                    <input asp-for="NewUser.Email" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="NewUser.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <fieldset>
                                        <legend class="form-label mb-2">Access roles</legend>
                                        <div class="role-picker">
                                            @foreach (var role in Model.AvailableRoles)
                                            {
                                                var checkboxId = $"new-role-{role.ToLowerInvariant().Replace("_", "-")}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="NewUser.Roles" value="@role" id="@checkboxId"
                                                           checked="@Model.NewUser.Roles.Contains(role)" />
                                                    <label class="form-check-label" for="@checkboxId">@RoleLabel(role)</label>
                                                </div>
                                            }
                                        </div>
                                        <span asp-validation-for="NewUser.Roles" class="text-danger"></span>
                                    </fieldset>
                                </div>
                                <div class="col-12">
                                    <div class="form-check border rounded-3 p-3 ps-5 bg-body-tertiary">
                                        <input asp-for="NewUser.CanAccessRestrictedClinicalData" class="form-check-input" />
                                        <label asp-for="NewUser.CanAccessRestrictedClinicalData" class="form-check-label fw-semibold"></label>
                                        <div class="form-text">
                                            Grants access to records and documents marked Restricted. Administrators receive this access automatically.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.Password" class="form-label"></label>
                                    <input asp-for="NewUser.Password" class="form-control" autocomplete="new-password" />
                                    <div class="form-text">At least 8 characters with upper/lowercase, a number, and a symbol.</div>
                                    <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewUser.ConfirmPassword" class="form-label"></label>
                                    <input asp-for="NewUser.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="NewUser.ConfirmPassword" class="text-danger"></span>
                                </div>
                                <div class="col-12 d-flex justify-content-end gap-2">
                                    <button class="btn btn-outline-secondary" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#createUserPanel">
                                        Cancel
                                    </button>
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create account
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="accountDirectoryHeading">
        <div class="admin-stat-grid mb-4" aria-label="Account summary">
            <div class="admin-stat-card">
                <span class="admin-stat-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
                <div><strong>@Model.Users.Count</strong><span>Total accounts</span></div>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-icon is-success"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
                <div><strong>@activeUsers</strong><span>Can sign in</span></div>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-icon is-warning"><i class="fa-solid fa-shield-alt" aria-hidden="true"></i></span>
                <div><strong>@administrators</strong><span>Administrators</span></div>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-icon is-warning"><i class="fa-solid fa-user-lock" aria-hidden="true"></i></span>
                <div><strong>@restrictedUsers</strong><span>Restricted-data access</span></div>
            </div>
        </div>

        <div class="card admin-table-card">
            <div class="card-header bg-body d-flex flex-wrap align-items-center justify-content-between gap-2 p-3">
                <div>
                    <h2 id="accountDirectoryHeading" class="h5 mb-1">Staff accounts</h2>
                    <p class="small text-body-secondary mb-0">Changes take effect on the user's next authorized request.</p>
                </div>
                <div class="input-group admin-user-search">
                    <span class="input-group-text bg-body" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input class="form-control" type="search" placeholder="Search accounts"
                           aria-label="Search staff accounts" data-user-search />
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Account</th>
                            <th scope="col">Status</th>
                            <th scope="col">Access roles</th>
                            <th scope="col" class="text-end">Security</th>
                        </tr>
                    </thead>
                    <tbody data-user-list>
                        @foreach (var user in Model.Users)
                        {
                            <tr data-user-row data-search-text="@($"{user.FullName} {user.EmployeeNumber} {user.Email} {user.Designation} {user.Department} {string.Join(" ", user.Roles)}")">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="account-avatar" aria-hidden="true">@user.FullName[..1].ToUpperInvariant()</span>
                                        <div>
                                            <strong class="d-block">@user.FullName</strong>
                                            <span class="small d-block">@user.EmployeeNumber · @user.Designation</span>
                                            <span class="small text-body-secondary d-block">@user.Email</span>
                                            <span class="small text-body-secondary">@user.MobileNumber</span>
                                            @if (user.IsCurrentUser)
                                            {
                                                <span class="badge text-bg-primary-subtle text-primary-emphasis ms-1">Your account</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge text-bg-danger-subtle border border-danger-subtle text-danger-emphasis">
                                            <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success-subtle border border-success-subtle text-success-emphasis">
                                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Active
                                        </span>
                                    }
                                    @if (user.CanAccessRestrictedClinicalData || user.Roles.Contains("ADMIN"))
                                    {
                                        <span class="badge text-bg-warning-subtle border border-warning-subtle text-warning-emphasis d-block mt-2">
                                            <i class="fa-solid fa-user-lock me-1" aria-hidden="true"></i>Restricted data
                                        </span>
                                    }
                                </td>
                                <td class="admin-role-cell">
                                    <form asp-action="UserChangeRole" method="post" class="role-access-form">
                                        <input type="hidden" name="UserId" value="@user.Id" />
                                        <div class="role-picker is-compact">
                                            @foreach (var role in Model.AvailableRoles)
                                            {
                                                var checkboxId = $"role-{user.Id}-{role.ToLowerInvariant().Replace("_", "-")}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="Roles"
                                                           value="@role" id="@checkboxId"
                                                           checked="@user.Roles.Contains(role)" />
                                                    <label class="form-check-label" for="@checkboxId">@RoleLabel(role)</label>
                                                </div>
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary mt-2" type="submit">
                                            Save access
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <button class="btn btn-sm btn-outline-primary" type="button"
                                                data-bs-toggle="modal" data-bs-target="#editProfileModal"
                                                data-profile-user-id="@user.Id"
                                                data-profile-email="@user.Email"
                                                data-profile-full-name="@user.FullName"
                                                data-profile-employee-number="@user.EmployeeNumber"
                                                data-profile-designation="@user.Designation"
                                                data-profile-department="@user.Department"
                                                data-profile-mobile="@user.MobileNumber"
                                                data-profile-work-phone="@user.WorkPhoneNumber"
                                                data-profile-restricted="@user.CanAccessRestrictedClinicalData.ToString().ToLowerInvariant()">
                                            <i class="fa-solid fa-address-card me-1" aria-hidden="true"></i>Edit profile
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                                data-bs-toggle="modal" data-bs-target="#resetPasswordModal"
                                                data-user-id="@user.Id" data-user-email="@user.Email">
                                            <i class="fa-solid fa-key me-1" aria-hidden="true"></i>Reset password
                                        </button>
                                        <form asp-action="UserSetLock" method="post">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="hidden" name="lockAccount" value="@(!user.IsLocked ? "true" : "false")" />
                                            <button class="btn btn-sm @(user.IsLocked ? "btn-outline-success" : "btn-outline-danger")"
                                                    type="submit" disabled="@user.IsCurrentUser"
                                                    title="@(user.IsCurrentUser ? "You cannot lock your own account" : null)">
                                                <i class="fa-solid @(user.IsLocked ? "fa-lock-open" : "fa-lock") me-1" aria-hidden="true"></i>
                                                @(user.IsLocked ? "Unlock" : "Lock")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr data-user-empty hidden>
                            <td colspan="4" class="text-center text-body-secondary py-5">
                                No accounts match your search.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UserUpdateProfile" method="post">
                <div class="modal-header">
                    <div>
                        <span class="page-eyebrow">Staff directory</span>
                        <h2 class="modal-title fs-5" id="editProfileTitle">Edit employee profile</h2>
                        <p class="small text-body-secondary mb-0" data-profile-email-label></p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="UserId" data-profile-user-id-input />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="profileFullName" class="form-label">Employee name</label>
                            <input id="profileFullName" name="FullName" class="form-control" required maxlength="200" data-profile-full-name-input />
                        </div>
                        <div class="col-md-4">
                            <label for="profileEmployeeNumber" class="form-label">Employee number</label>
                            <input id="profileEmployeeNumber" name="EmployeeNumber" class="form-control" required maxlength="50" data-profile-employee-number-input />
                        </div>
                        <div class="col-md-6">
                            <label for="profileDesignation" class="form-label">Designation</label>
                            <input id="profileDesignation"
                                   name="Designation"
                                   class="form-control"
                                   type="search"
                                   list="staffDesignationOptions"
                                   autocomplete="off"
                                   required
                                   maxlength="150"
                                   data-profile-designation-input />
                        </div>
                        <div class="col-md-6">
                            <label for="profileDepartment" class="form-label">Department</label>
                            <input id="profileDepartment" name="Department" class="form-control" maxlength="150" data-profile-department-input />
                        </div>
                        <div class="col-md-6">
                            <label for="profileMobile" class="form-label">Mobile number</label>
                            <input id="profileMobile" name="MobileNumber" class="form-control" type="tel" required maxlength="30" data-profile-mobile-input />
                        </div>
                        <div class="col-md-6">
                            <label for="profileWorkPhone" class="form-label">Work phone</label>
                            <input id="profileWorkPhone" name="WorkPhoneNumber" class="form-control" type="tel" maxlength="30" data-profile-work-phone-input />
                        </div>
                        <div class="col-12">
                            <div class="form-check border rounded-3 p-3 ps-5 bg-body-tertiary">
                                <input id="profileRestrictedAccess" name="CanAccessRestrictedClinicalData"
                                       class="form-check-input" type="checkbox" value="true" data-profile-restricted-input />
                                <input name="CanAccessRestrictedClinicalData" type="hidden" value="false" />
                                <label for="profileRestrictedAccess" class="form-check-label fw-semibold">
                                    Allow restricted clinical data
                                </label>
                                <div class="form-text">This is a high-trust permission. Assign only when required for the employee's duties.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save employee profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

<datalist id="staffDesignationOptions">
    <option value="Prosthetist"></option>
    <option value="Orthotist"></option>
    <option value="Prosthetist / Orthotist"></option>
</datalist>

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UserResetPassword" method="post">
                <div class="modal-header">
                    <div>
                        <span class="page-eyebrow">Account security</span>
                        <h2 class="modal-title fs-5" id="resetPasswordTitle">Set a temporary password</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-body-secondary">Resetting the password for <strong data-reset-user-email></strong>.</p>
                    <input type="hidden" name="UserId" data-reset-user-id />
                    <input type="email" class="visually-hidden" tabindex="-1" aria-hidden="true"
                           autocomplete="username" data-reset-username />
                    <div class="mb-3">
                        <label for="resetNewPassword" class="form-label">New temporary password</label>
                        <input id="resetNewPassword" name="NewPassword" type="password" class="form-control"
                               autocomplete="new-password" required />
                        <div class="form-text">Use at least 8 characters with upper/lowercase, a number, and a symbol.</div>
                    </div>
                    <div>
                        <label for="resetConfirmPassword" class="form-label">Confirm password</label>
                        <input id="resetConfirmPassword" name="ConfirmPassword" type="password" class="form-control"
                               autocomplete="new-password" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Set password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private static string RoleLabel(string role) => role switch
    {
        "ADMIN" => "Administrator",
        "CLINICIAN" => "Clinician",
        "DATA_ENTRY" => "Registration",
        "MANAGEMENT" => "Management",
        "VIEWER" => "Reports",
        _ => role
    };
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const search = document.querySelector("[data-user-search]");
            const rows = [...document.querySelectorAll("[data-user-row]")];
            const empty = document.querySelector("[data-user-empty]");
            search?.addEventListener("input", () => {
                const query = search.value.trim().toLocaleLowerCase();
                let visible = 0;
                rows.forEach(row => {
                    const matches = !query || row.dataset.searchText.toLocaleLowerCase().includes(query);
                    row.hidden = !matches;
                    if (matches) visible++;
                });
                if (empty) empty.hidden = visible !== 0;
            });

            const resetModal = document.querySelector("#resetPasswordModal");
            resetModal?.addEventListener("show.bs.modal", event => {
                const trigger = event.relatedTarget;
                resetModal.querySelector("[data-reset-user-id]").value = trigger.dataset.userId;
                resetModal.querySelector("[data-reset-user-email]").textContent = trigger.dataset.userEmail;
                resetModal.querySelector("[data-reset-username]").value = trigger.dataset.userEmail;
                resetModal.querySelectorAll('input[type="password"]').forEach(input => input.value = "");
            });

            const profileModal = document.querySelector("#editProfileModal");
            profileModal?.addEventListener("show.bs.modal", event => {
                const trigger = event.relatedTarget;
                profileModal.querySelector("[data-profile-user-id-input]").value = trigger.dataset.profileUserId;
                profileModal.querySelector("[data-profile-email-label]").textContent = trigger.dataset.profileEmail;
                profileModal.querySelector("[data-profile-full-name-input]").value = trigger.dataset.profileFullName;
                profileModal.querySelector("[data-profile-employee-number-input]").value = trigger.dataset.profileEmployeeNumber;
                profileModal.querySelector("[data-profile-designation-input]").value = trigger.dataset.profileDesignation;
                profileModal.querySelector("[data-profile-department-input]").value = trigger.dataset.profileDepartment || "";
                profileModal.querySelector("[data-profile-mobile-input]").value = trigger.dataset.profileMobile;
                profileModal.querySelector("[data-profile-work-phone-input]").value = trigger.dataset.profileWorkPhone || "";
                profileModal.querySelector("[data-profile-restricted-input]").checked = trigger.dataset.profileRestricted === "true";
            });
        })();
    </script>
}
