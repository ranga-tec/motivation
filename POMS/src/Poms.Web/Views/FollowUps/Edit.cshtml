@model Poms.Web.ViewModels.FollowUpViewModel

@{
    ViewData["Title"] = "Edit Follow-up";
}

<h1>Edit Follow-up</h1>
<p class="text-muted">Patient: <strong>@Model.PatientNumber - @Model.PatientName</strong></p>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EpisodeId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="FollowUpDate" class="form-label"></label>
            <input asp-for="FollowUpDate" class="form-control" type="date" />
            <span asp-validation-for="FollowUpDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="StartTime" class="form-label"></label>
            <input asp-for="StartTime" class="form-control" type="time" required />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EndTime" class="form-label"></label>
            <input asp-for="EndTime" class="form-control" type="time" required />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-check border border-warning-subtle rounded-3 p-3 ps-5 mb-3 bg-warning-subtle">
        <input asp-for="IsRestricted" class="form-check-input" />
        <label asp-for="IsRestricted" class="form-check-label fw-semibold"></label>
        <div class="form-text">Only authorized staff and the original author can access this follow-up record.</div>
    </div>

    <button type="submit" class="btn btn-warning">Update Follow-up</button>
    <a asp-controller="Episodes" asp-action="Details" asp-route-id="@Model.EpisodeId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
