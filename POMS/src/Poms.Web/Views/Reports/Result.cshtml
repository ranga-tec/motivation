@model Poms.Web.ViewModels.ReportResultViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    <div>
        <a asp-action="@Model.ActionName" asp-all-route-data="@(new Dictionary<string, string?> {
            ["export"] = "true",
            ["DateFrom"] = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"),
            ["DateTo"] = Model.Filter.DateTo?.ToString("yyyy-MM-dd"),
            ["CenterId"] = Model.Filter.CenterId?.ToString(),
            ["ProvinceId"] = Model.Filter.ProvinceId?.ToString(),
            ["PatientNumber"] = Model.Filter.PatientNumber,
            ["IsForeign"] = Model.Filter.IsForeign?.ToString(),
            ["AssessmentType"] = Model.Filter.AssessmentType?.ToString(),
            ["LimbCategory"] = Model.Filter.LimbCategory?.ToString(),
            ["RecordStatus"] = Model.Filter.RecordStatus?.ToString(),
            ["Year"] = Model.Filter.Year?.ToString()
        })" class="btn btn-outline-secondary" target="_blank">Export PDF</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Reports</a>
    </div>
</div>

<form asp-action="@Model.ActionName" method="get" class="row g-3 mb-3">
    <div class="col-md-2">
        <label class="form-label">Date From</label>
        <input type="date" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Date To</label>
        <input type="date" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Patient Number</label>
        <input type="text" name="PatientNumber" value="@Model.Filter.PatientNumber" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Year</label>
        <input type="number" name="Year" value="@Model.Filter.Year" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Location</label>
        <select name="CenterId" class="form-select">
            <option value="">All Locations</option>
            @foreach (var c in (SelectList)ViewBag.Centers)
            {
                <option value="@c.Value" selected="@(c.Value == Model.Filter.CenterId?.ToString())">@c.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Province</label>
        <select name="ProvinceId" class="form-select">
            <option value="">All Provinces</option>
            @foreach (var p in (SelectList)ViewBag.Provinces)
            {
                <option value="@p.Value" selected="@(p.Value == Model.Filter.ProvinceId?.ToString())">@p.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Local / Foreign</label>
        <select name="IsForeign" class="form-select">
            <option value="">Both</option>
            <option value="false" selected="@(Model.Filter.IsForeign == false)">Local</option>
            <option value="true" selected="@(Model.Filter.IsForeign == true)">Foreign</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Assessment Type</label>
        <select name="AssessmentType" class="form-select">
            <option value="">All</option>
            @foreach (var a in (SelectList)ViewBag.AssessmentTypes)
            {
                <option value="@a.Value" selected="@(a.Value == Model.Filter.AssessmentType?.ToString())">@a.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Prosthetic / Orthotic Type (Limb)</label>
        <select name="LimbCategory" class="form-select">
            <option value="">All</option>
            @foreach (var l in (SelectList)ViewBag.LimbCategories)
            {
                <option value="@l.Value" selected="@(l.Value == Model.Filter.LimbCategory?.ToString())">@l.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Record Status</label>
        <select name="RecordStatus" class="form-select">
            <option value="">All</option>
            @foreach (var s in (SelectList)ViewBag.RecordStatuses)
            {
                <option value="@s.Value" selected="@(s.Value == Model.Filter.RecordStatus?.ToString())">@s.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Apply Filters</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                @foreach (var h in Model.Headers)
                {
                    <th>@h</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Rows.Any())
{
    <p class="text-muted">No data found for the selected filters.</p>
}
