@{
    ViewData["Title"] = "Reports";
}

<div class="content-page">
<header class="page-header-professional">
    <div><span class="page-eyebrow">Analysis and exports</span><h1>Reports</h1><p>Open operational, clinical, and geographic reporting views.</p></div>
</header>

<div class="row">
    @{
        var reports = new[]
        {
            ("PatientRegistration", "Patient Registration Report"),
            ("ActiveRecords", "Active Records Report"),
            ("Assessment", "Assessment Report"),
            ("ProstheticAssessment", "Prosthetic Assessment Report"),
            ("OrthoticAssessment", "Orthotic Assessment Report"),
            ("Fitting", "Fitting Report"),
            ("Delivery", "Delivery Report"),
            ("FollowUp", "Follow-up Report"),
            ("LocationWise", "Location-wise Report"),
            ("ForeignPatient", "Foreign Patient Report"),
            ("DateWise", "Date-wise Report"),
            ("ProvinceWise", "Province-wise Report"),
            ("YearWise", "Year-wise Report"),
        };
    }
    @foreach (var (action, title) in reports)
    {
        <div class="col-md-6 col-xl-4 mb-3">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="admin-module-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                    <div class="flex-grow-1"><h2 class="h6 mb-1">@title</h2><span class="small text-secondary">View and filter report data</span></div>
                    <a asp-action="@action" class="btn btn-sm btn-outline-primary" aria-label="Open @title">Open</a>
                </div>
            </div>
        </div>
    }
</div>
</div>
