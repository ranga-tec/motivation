@{
    ViewData["Title"] = "Reports";
}

<h1 class="mb-4">Reports</h1>

<div class="row">
    @{
        var reports = new[]
        {
            ("PatientRegistration", "Patient Registration Report"),
            ("ActiveRecords", "Active Records Report"),
            ("Assessment", "Assessment Report"),
            ("ProstheticAssessment", "Prosthetic Assessment Report"),
            ("OrthoticAssessment", "Orthotic Assessment Report"),
            ("Fitting", "Fitting Report"),
            ("Delivery", "Delivery Report"),
            ("FollowUp", "Follow-up Report"),
            ("LocationWise", "Location-wise Report"),
            ("ForeignPatient", "Foreign Patient Report"),
            ("DateWise", "Date-wise Report"),
            ("ProvinceWise", "Province-wise Report"),
            ("YearWise", "Year-wise Report"),
        };
    }
    @foreach (var (action, title) in reports)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">@title</h6>
                    <a asp-action="@action" class="btn btn-sm btn-primary">Open</a>
                </div>
            </div>
        </div>
    }
</div>
