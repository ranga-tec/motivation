@model IEnumerable<Poms.Domain.Entities.Episode>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Clinical Records";
}

<div class="content-page">
        <header class="page-header-professional">
            <div><span class="page-eyebrow">Clinical care</span><h1>Clinical records</h1><p>Find and continue active patient episodes.</p></div>
        </header>

        <div class="surface-card">
            <div class="card-header">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-5">
                        <input type="text" name="searchString" value="@ViewBag.SearchString"
                               class="form-control" placeholder="Search by patient number or name..." />
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (var status in Enum.GetValues(typeof(Poms.Domain.Enums.RecordStatus)))
                            {
                                <option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@status</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="centerId" class="form-select">
                            <option value="">All Locations</option>
                            @foreach (var center in ViewBag.Centers as SelectList)
                            {
                                <option value="@center.Value" selected="@(center.Value == ViewBag.CenterId?.ToString())">@center.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
                    </div>
                </form>
            </div>

            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Location</th>
                                    <th>Record Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Patient.PatientNumber</strong><br />
                                            <small class="text-muted">@item.Patient.FullName</small>
                                        </td>
                                        <td>@item.Center.Name</td>
                                        <td>
                                            @item.RecordDate.ToString("dd/MM/yyyy")
                                            @(item.RecordTime?.ToString("HH:mm") ?? "")
                                        </td>
                                        <td>
                                            <span class="badge @(item.Status == Poms.Domain.Enums.RecordStatus.Active ? "bg-success" : item.Status == Poms.Domain.Enums.RecordStatus.Completed ? "bg-secondary" : "bg-danger")">
                                                @item.Status
                                            </span>
                                            @if (item.IsRestricted)
                                            {
                                                <span class="badge text-bg-warning text-dark ms-1"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">View</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-status="@ViewBag.Status"
                                           asp-route-centerId="@ViewBag.CenterId">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="empty-state"><i class="fa-solid fa-folder-open" aria-hidden="true"></i><strong class="d-block text-body mb-1">No records found</strong>Records are created from a patient’s folder.</div>
                }
            </div>
        </div>
</div>
