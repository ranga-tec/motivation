@model Poms.Web.ViewModels.EpisodeViewModel

@{
    ViewData["Title"] = "New Record";
}

<h1>New Patient Record</h1>

<form asp-action="Create" method="post" class="needs-validation">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (!string.IsNullOrEmpty(Model.PatientNumber))
    {
        <input type="hidden" asp-for="PatientId" />
        <p class="text-muted">Patient: <strong>@Model.PatientNumber - @Model.PatientName</strong></p>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="PatientId" class="form-label"></label>
            <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients">
                <option value="">-- Select Patient --</option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CenterId" class="form-label"></label>
            <select asp-for="CenterId" class="form-select" asp-items="ViewBag.Centers">
                <option value="">-- Select Centre --</option>
            </select>
            <span asp-validation-for="CenterId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RecordDate" class="form-label"></label>
            <input asp-for="RecordDate" class="form-control" type="date" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-check border border-warning-subtle rounded-3 p-3 ps-5 mb-3 bg-warning-subtle">
        <input asp-for="IsRestricted" class="form-check-input" />
        <label asp-for="IsRestricted" class="form-check-label fw-semibold"></label>
        <div class="form-text">Restricts this complete clinical record to authorized staff and its original author.</div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Create Record</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
