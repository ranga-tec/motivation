@model Poms.Web.ViewModels.EpisodeViewModel

@{
    ViewData["Title"] = "Edit Record";
}

<h1>Edit Record</h1>
<p class="text-muted">Patient: <strong>@Model.PatientNumber - @Model.PatientName</strong></p>

<form asp-action="Edit" method="post" class="needs-validation">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PatientId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CenterId" class="form-label"></label>
            <select asp-for="CenterId" class="form-select" asp-items="ViewBag.Centers"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RecordDate" class="form-label"></label>
            <input asp-for="RecordDate" class="form-control" type="date" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-warning">Update Record</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
