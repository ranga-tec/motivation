@model Poms.Domain.Entities.Episode

@{
    ViewData["Title"] = "Record Details";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Record Details</h2>
                @if (Model.IsRestricted)
                {
                    <span class="badge text-bg-warning text-dark mb-2">
                        <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Restricted clinical record
                    </span>
                }
                <p class="text-muted mb-0">
                    Record for <strong class="text-primary">@Model.Patient.PatientNumber</strong> - @Model.Patient.FullName
                    at @Model.Center.Name
                </p>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-controller="Patients" asp-action="Folder" asp-route-id="@Model.Patient.Id" class="btn btn-secondary">Patient Folder</a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header"><h5>Record Information</h5></div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th width="20%">Record Date &amp; Time:</th>
                        <td>
                            @Model.RecordDate.ToString("dd-MMM-yyyy")
                            @(Model.RecordTime?.ToString("HH:mm") ?? "Time not recorded")
                        </td>
                    </tr>
                    <tr><th>Status:</th>
                        <td>
                            <span class="badge @(Model.Status == Poms.Domain.Enums.RecordStatus.Active ? "bg-success" : Model.Status == Poms.Domain.Enums.RecordStatus.Completed ? "bg-secondary" : "bg-danger")">
                                @Model.Status
                            </span>
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <tr><th>Remarks:</th><td>@Model.Remarks</td></tr>
                    }
                </table>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6>Assessments (@Model.Assessments.Count)</h6>
                        <a asp-controller="Assessments" asp-action="Create" asp-route-episodeId="@Model.Id" class="btn btn-sm btn-outline-primary">+ Create New Assessment</a>
                    </div>
                    <div class="card-body">
                        @if (Model.Assessments.Any())
                        {
                            @foreach (var a in Model.Assessments.OrderByDescending(a => a.AssessedOn))
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <small class="text-muted">
                                        @a.AssessedOn.ToString("dd-MMM-yyyy")
                                        @if (a.StartTime.HasValue && a.EndTime.HasValue)
                                        {
                                            <span> · @a.StartTime.Value.ToString("HH:mm")–@a.EndTime.Value.ToString("HH:mm")</span>
                                        }
                                    </small>
                                    @if (a.IsRestricted)
                                    {
                                        <span class="badge text-bg-warning text-dark ms-2"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                    }
                                    <a asp-controller="Assessments" asp-action="Edit" asp-route-id="@a.Id" class="float-end ms-2">Edit</a>
                                    <a asp-controller="Print" asp-action="AssessmentForm" asp-route-assessmentId="@a.Id" class="float-end ms-2" target="_blank">Print Assessment</a>
                                    <a asp-controller="Print" asp-action="PrescriptionForm" asp-route-assessmentId="@a.Id" class="float-end" target="_blank">Print Prescription</a>
                                    <p class="mb-1">@a.AssessmentType / @a.LimbCategory - @a.MainProblemType.Name - Side: @a.Side</p>
                                    @foreach (var p in a.Prescriptions)
                                    {
                                        <div><small>@p.Side: @p.PrescriptionLabel @(p.SubType != null ? $"({p.SubType})" : "") @(p.OtherText != null ? $"- {p.OtherText}" : "")</small></div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No assessments recorded yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6>Fittings (@Model.Fittings.Count)</h6>
                        <a asp-controller="Fittings" asp-action="Create" asp-route-episodeId="@Model.Id" class="btn btn-sm btn-outline-success">+ Add Fitting</a>
                    </div>
                    <div class="card-body">
                        @if (Model.Fittings.Any())
                        {
                            @foreach (var fitting in Model.Fittings.OrderByDescending(f => f.FittingDate))
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <small class="text-muted">@fitting.FittingDate.ToString("dd-MMM-yyyy")</small>
                                    @if (fitting.IsRestricted)
                                    {
                                        <span class="badge text-bg-warning text-dark ms-2"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                    }
                                    <a asp-controller="Fittings" asp-action="Edit" asp-route-id="@fitting.Id" class="float-end">Edit</a>
                                    <p class="mb-1">@(fitting.Notes ?? "No notes recorded")</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No fittings recorded yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6>Deliveries (@Model.Deliveries.Count)</h6>
                        <a asp-controller="Deliveries" asp-action="Create" asp-route-episodeId="@Model.Id" class="btn btn-sm btn-outline-info">+ Add Delivery</a>
                    </div>
                    <div class="card-body">
                        @if (Model.Deliveries.Any())
                        {
                            @foreach (var d in Model.Deliveries.OrderByDescending(d => d.DeliveryDate))
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <small class="text-muted">
                                        @d.DeliveryDate.ToString("dd-MMM-yyyy")
                                        @if (d.DeliveryTime.HasValue)
                                        {
                                            <span> · @d.DeliveryTime.Value.ToString("HH:mm")</span>
                                        }
                                    </small>
                                    @if (d.IsRestricted)
                                    {
                                        <span class="badge text-bg-warning text-dark ms-2"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                    }
                                    <a asp-controller="Deliveries" asp-action="Edit" asp-route-id="@d.Id" class="float-end ms-2">Edit</a>
                                    <a asp-controller="Print" asp-action="DeliveryNote" asp-route-deliveryId="@d.Id" class="float-end" target="_blank">Print</a>
                                    <p class="mb-1">@(d.Notes ?? "No notes recorded")</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No deliveries recorded yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6>Follow-ups (@Model.FollowUps.Count)</h6>
                        <a asp-controller="FollowUps" asp-action="Create" asp-route-episodeId="@Model.Id" class="btn btn-sm btn-outline-warning">+ Add Follow-up</a>
                    </div>
                    <div class="card-body">
                        @if (Model.FollowUps.Any())
                        {
                            @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <small class="text-muted">
                                        @f.FollowUpDate.ToString("dd-MMM-yyyy")
                                        @if (f.StartTime.HasValue && f.EndTime.HasValue)
                                        {
                                            <span> · @f.StartTime.Value.ToString("HH:mm")–@f.EndTime.Value.ToString("HH:mm")</span>
                                        }
                                    </small>
                                    @if (f.IsRestricted)
                                    {
                                        <span class="badge text-bg-warning text-dark ms-2"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                    }
                                    <a asp-controller="FollowUps" asp-action="Edit" asp-route-id="@f.Id" class="float-end ms-2">Edit</a>
                                    <a asp-controller="Print" asp-action="FollowUpNote" asp-route-followUpId="@f.Id" class="float-end" target="_blank">Print</a>
                                    <p class="mb-1">@(f.Notes ?? "No notes recorded")</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No follow-ups recorded yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6>Documents (@Model.Documents.Count)</h6>
                <a asp-controller="Files" asp-action="UploadForEpisode" asp-route-episodeId="@Model.Id" class="btn btn-sm btn-outline-secondary">+ Upload Document</a>
            </div>
            <div class="card-body">
                @if (Model.Documents.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Type</th><th>File Name</th><th>Uploaded</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var doc in Model.Documents)
                            {
                                <tr>
                                    <td>
                                        @doc.DocumentType
                                        @if (doc.IsRestricted)
                                        {
                                            <span class="badge text-bg-warning text-dark ms-1"><i class="fa-solid fa-lock me-1"></i>Restricted</span>
                                        }
                                    </td>
                                    <td>@doc.FileName</td>
                                    <td>@doc.UploadedAt.ToString("dd-MMM-yyyy")</td>
                                    <td><a asp-controller="Files" asp-action="Download" asp-route-id="@doc.Id" asp-route-scope="episode" class="btn btn-sm btn-success">Download</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No documents uploaded yet.</p>
                }
            </div>
        </div>
    </div>
</div>
