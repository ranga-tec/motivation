@model IEnumerable<Poms.Domain.Entities.Patient>

<div class="d-flex justify-content-between align-items-center mb-2">
    <p class="text-secondary small mb-0" data-patient-result-count>
        @if (ViewBag.TotalCount == 0)
        {
            <text>No patients match this search.</text>
        }
        else
        {
            <text>@ViewBag.TotalCount matching patient@(ViewBag.TotalCount == 1 ? "" : "s")</text>
        }
    </p>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Patient Number</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Category</th>
                <th>Identification</th>
                <th>Branch</th>
                <th>Registration Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-secondary py-4">
                        Nothing found. Try part of a name, patient number, ID or phone number.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.PatientNumber</strong></td>
                    <td>@item.FullName</td>
                    <td>@item.Dob.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Category</td>
                    <td>@item.IdentificationType: @item.IdentificationNumber</td>
                    <td>@item.Center.Name</td>
                    <td>@item.RegistrationDate.ToString("dd-MMM-yyyy")</td>
                    <td>
                        <a asp-action="Folder" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-provinceId="@ViewBag.ProvinceId"
                       asp-route-districtId="@ViewBag.DistrictId"
                       asp-route-cityId="@ViewBag.CityId"
                       asp-route-centerId="@ViewBag.CenterId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
