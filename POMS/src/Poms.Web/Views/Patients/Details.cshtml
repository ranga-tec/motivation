@model Poms.Domain.Entities.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Patient Details</h1>
        <p class="text-muted mb-0">Patient Number: <strong class="text-primary">@Model.PatientNumber</strong></p>
    </div>
    <div>
        <a asp-action="Folder" asp-route-id="@Model.Id" class="btn btn-primary">Open Patient Folder</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Personal Details</h5></div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><th width="40%">Full Name:</th><td>@Model.FullName</td></tr>
                    <tr><th>Name with Initials:</th><td>@Model.NameWithInitials</td></tr>
                    <tr><th>Date of Birth:</th><td>@Model.Dob.ToString("dd-MMM-yyyy")</td></tr>
                    <tr><th>Sex:</th><td>@Model.Sex</td></tr>
                    <tr><th>Category:</th><td>@Model.Category</td></tr>
                    <tr><th>Identification:</th><td>@Model.IdentificationType: @Model.IdentificationNumber</td></tr>
                    <tr><th>Registration Date:</th><td>@Model.RegistrationDate.ToString("dd-MMM-yyyy")</td></tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Contact Information</h5></div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><th width="40%">Address:</th><td>@Model.Address1<br />@Model.Address2</td></tr>
                    <tr><th>Province:</th><td>@Model.Province.Name</td></tr>
                    <tr><th>District:</th><td>@Model.District.Name</td></tr>
                    <tr><th>Location:</th><td>@Model.Center.Name</td></tr>
                    <tr><th>Email:</th><td>@(Model.Email ?? "N/A")</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
