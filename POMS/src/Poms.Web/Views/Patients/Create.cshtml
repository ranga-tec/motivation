@model Poms.Web.ViewModels.PatientViewModel

@{
    ViewData["Title"] = "Register New Patient";
}

<h1>Register New Patient</h1>

@if (ViewBag.ShowDuplicateWarning == true)
{
    <div class="alert alert-warning">
        A patient with a similar name and date of birth already exists:
        <strong>@ViewBag.ExistingPatientNumber - @ViewBag.ExistingPatientName</strong>.
        Review before proceeding.
        <form asp-action="Create" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ConfirmDuplicateWarning" value="true" />
            @* The rest of the form fields are re-posted by the main form below; this button just flips the flag client-side. *@
        </form>
    </div>
}

<form asp-action="Create" method="post" class="needs-validation" id="patientForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="ConfirmDuplicateWarning" id="confirmDuplicateWarning" />

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Personal Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NameWithInitials" class="form-label"></label>
                    <input asp-for="NameWithInitials" class="form-control" />
                    <span asp-validation-for="NameWithInitials" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Dob" class="form-label"></label>
                    <input asp-for="Dob" class="form-control" type="date" />
                    <span asp-validation-for="Dob" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Sex" class="form-label"></label>
                    <select asp-for="Sex" class="form-select" asp-items="ViewBag.SexOptions">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Sex" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Employment" class="form-label"></label>
                    <input asp-for="Employment" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select" id="categorySelect" asp-items="ViewBag.PatientCategories"></select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3" id="nationalityField">
                    <label asp-for="Nationality" class="form-label"></label>
                    <input asp-for="Nationality" class="form-control" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="IdentificationType" class="form-label"></label>
                    <select asp-for="IdentificationType" class="form-select" asp-items="ViewBag.IdentificationTypes"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="IdentificationNumber" class="form-label"></label>
                    <input asp-for="IdentificationNumber" class="form-control" id="idNumberInput" autocomplete="off" />
                    <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
                    <div id="duplicateAlert" class="alert alert-warning mt-2 d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Contact Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Address1" class="form-label"></label>
                    <input asp-for="Address1" class="form-control" />
                    <span asp-validation-for="Address1" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Address2" class="form-label"></label>
                    <input asp-for="Address2" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ProvinceId" class="form-label"></label>
                    <select asp-for="ProvinceId" class="form-select" id="provinceSelect" asp-items="ViewBag.Provinces">
                        <option value="">-- Select Province --</option>
                    </select>
                    <span asp-validation-for="ProvinceId" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="DistrictId" class="form-label"></label>
                    <select asp-for="DistrictId" class="form-select" id="districtSelect" disabled>
                        <option value="">-- Select District --</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="CityId" class="form-label"></label>
                    <select asp-for="CityId" class="form-select" id="citySelect" disabled>
                        <option value="">-- Select City --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="CityOther" class="form-label"></label>
                    <input asp-for="CityOther" class="form-control" />
                    <span asp-validation-for="CityOther" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CenterId" class="form-label"></label>
                    <select asp-for="CenterId" class="form-select" asp-items="ViewBag.Centers">
                        <option value="">-- Select Centre --</option>
                    </select>
                    <span asp-validation-for="CenterId" class="text-danger"></span>
                </div>
            </div>

            <h6 class="mt-3">Telephone Numbers</h6>
            <div id="contactsContainer">
                @for (int i = 0; i < Model.Contacts.Count; i++)
                {
                    <div class="row contact-row mb-2">
                        <div class="col-md-4">
                            <input name="Contacts[@i].TelephoneNo" class="form-control" placeholder="Telephone No." value="@Model.Contacts[i].TelephoneNo" />
                        </div>
                        <div class="col-md-4">
                            <input name="Contacts[@i].DateConfirmed" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <input name="Contacts[@i].PersonChecked" class="form-control" placeholder="Person Checked" />
                        </div>
                    </div>
                }
            </div>
            <button type="button" id="addContactBtn" class="btn btn-sm btn-outline-secondary mb-3">+ Add another number</button>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ReferralSourceId" class="form-label"></label>
                    <select asp-for="ReferralSourceId" class="form-select" id="referralSelect" asp-items="ViewBag.ReferralSources">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3" id="referralOtherField">
                    <label asp-for="ReferralSourceOther" class="form-label"></label>
                    <input asp-for="ReferralSourceOther" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Guardian / Carer Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GuardianName" class="form-label"></label>
                    <input asp-for="GuardianName" class="form-control" />
                    <span asp-validation-for="GuardianName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GuardianRelationship" class="form-label"></label>
                    <input asp-for="GuardianRelationship" class="form-control" />
                    <span asp-validation-for="GuardianRelationship" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="GuardianAddress" class="form-label"></label>
                    <input asp-for="GuardianAddress" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GuardianPhone" class="form-label"></label>
                    <input asp-for="GuardianPhone" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GuardianMobile" class="form-label"></label>
                    <input asp-for="GuardianMobile" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Registration Details</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TravelTimeDistance" class="form-label"></label>
                    <input asp-for="TravelTimeDistance" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="RegistrationDate" class="form-label"></label>
                    <input asp-for="RegistrationDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="RegistrationProcessedBy" class="form-label"></label>
                    <input asp-for="RegistrationProcessedBy" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Remarks" class="form-label"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Register Patient</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleNationality() {
                $('#nationalityField').toggle($('#categorySelect').val() === 'Foreign');
            }
            $('#categorySelect').change(toggleNationality);
            toggleNationality();

            function toggleReferralOther() {
                var text = $('#referralSelect option:selected').text();
                $('#referralOtherField').toggle(text === 'Other');
            }
            $('#referralSelect').change(toggleReferralOther);
            toggleReferralOther();

            $('#provinceSelect').change(function () {
                var provinceId = $(this).val();
                $('#districtSelect').prop('disabled', true).empty().append('<option value="">-- Select District --</option>');
                $('#citySelect').prop('disabled', true).empty().append('<option value="">-- Select City --</option>');
                if (provinceId) {
                    $.get('/Patients/GetDistrictsByProvince', { provinceId: provinceId }, function (data) {
                        $('#districtSelect').prop('disabled', false);
                        $.each(data, function (i, d) { $('#districtSelect').append($('<option>').val(d.id).text(d.name)); });
                    });
                }
            });

            $('#districtSelect').change(function () {
                var districtId = $(this).val();
                $('#citySelect').prop('disabled', true).empty().append('<option value="">-- Select City --</option>');
                if (districtId) {
                    $.get('/Patients/GetCitiesByDistrict', { districtId: districtId }, function (data) {
                        $('#citySelect').prop('disabled', false);
                        $.each(data, function (i, c) { $('#citySelect').append($('<option>').val(c.id).text(c.name)); });
                    });
                }
            });

            var contactIndex = $('#contactsContainer .contact-row').length;
            $('#addContactBtn').click(function () {
                var row = '<div class="row contact-row mb-2">' +
                    '<div class="col-md-4"><input name="Contacts[' + contactIndex + '].TelephoneNo" class="form-control" placeholder="Telephone No." /></div>' +
                    '<div class="col-md-4"><input name="Contacts[' + contactIndex + '].DateConfirmed" type="date" class="form-control" /></div>' +
                    '<div class="col-md-4"><input name="Contacts[' + contactIndex + '].PersonChecked" class="form-control" placeholder="Person Checked" /></div>' +
                    '</div>';
                $('#contactsContainer').append(row);
                contactIndex++;
            });

            $('#idNumberInput').on('blur', function () {
                var idType = $('#IdentificationType').val();
                var idNumber = $(this).val();
                var fullName = $('#FullName').val();
                var dob = $('#Dob').val();
                if (!idNumber) return;
                $.get('/Patients/CheckDuplicateAjax', { idType: idType, idNumber: idNumber, fullName: fullName, dob: dob }, function (data) {
                    if (data.isExactDuplicate) {
                        $('#duplicateAlert').removeClass('d-none alert-warning').addClass('alert-danger')
                            .text('Duplicate found: ' + data.existingPatientNumber + ' - ' + data.existingPatientName);
                    } else if (data.hasSimilarNameOrDob) {
                        $('#duplicateAlert').removeClass('d-none alert-danger').addClass('alert-warning')
                            .text('Similar patient already exists: ' + data.existingPatientNumber + ' - ' + data.existingPatientName);
                    } else {
                        $('#duplicateAlert').addClass('d-none');
                    }
                });
            });
        });
    </script>
}
