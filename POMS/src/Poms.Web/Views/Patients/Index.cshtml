@model IEnumerable<Poms.Domain.Entities.Patient>

@{
    ViewData["Title"] = "Patient Folder";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="page-eyebrow">Clinical records</span>
        <h1 class="mb-1">Patient folder</h1>
        <p class="text-secondary mb-0">Find an existing patient or start a guided registration.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a asp-action="ImportLegacy" class="btn btn-outline-primary btn-lg">
            <i class="fa-solid fa-file-image me-1" aria-hidden="true"></i> Import old form
        </a>
        <a asp-action="Create"
           class="btn btn-primary btn-lg"
           data-workflow-modal-url="@Url.Action("Create", "Patients", new { modal = true })"
           data-workflow-modal-target="#patientRegistrationModal">
            <i class="fa-solid fa-user-plus me-1" aria-hidden="true"></i> Register new patient
        </a>
    </div>
</div>

<div class="card filter-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3" id="patientSearchForm">
            <div class="col-md-4">
                <label for="patientSearch" class="form-label">Search patients</label>
                <div class="position-relative">
                    <input type="search" name="searchString" value="@ViewBag.SearchString"
                           id="patientSearch" class="form-control" autocomplete="off"
                           placeholder="Start typing a name, patient number, ID or phone" />
                    <span class="position-absolute top-50 end-0 translate-middle-y me-2 d-none"
                          id="patientSearchSpinner" aria-hidden="true">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                    </span>
                </div>
                <div class="form-text">Results update as you type.</div>
            </div>
            <div class="col-md-2">
                <label for="provinceFilter" class="form-label">Province</label>
                <select name="provinceId" id="provinceFilter" class="form-select">
                    <option value="">All Provinces</option>
                    @foreach (var province in ViewBag.Provinces as SelectList)
                    {
                        <option value="@province.Value" selected="@(province.Value == ViewBag.ProvinceId?.ToString())">@province.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="districtFilter" class="form-label">District</label>
                <select name="districtId" id="districtFilter" class="form-select">
                    <option value="">All Districts</option>
                    @foreach (var district in ViewBag.Districts as SelectList)
                    {
                        <option value="@district.Value" selected="@(district.Value == ViewBag.DistrictId?.ToString())">@district.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="cityFilter" class="form-label">City</label>
                <select name="cityId" id="cityFilter" class="form-select">
                    <option value="">All Cities</option>
                    @foreach (var city in ViewBag.Cities as SelectList)
                    {
                        <option value="@city.Value" selected="@(city.Value == ViewBag.CityId?.ToString())">@city.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="centerFilter" class="form-label">Branch</label>
                <select name="centerId" id="centerFilter" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var center in ViewBag.Centers as SelectList)
                    {
                        <option value="@center.Value" selected="@(center.Value == ViewBag.CenterId?.ToString())">@center.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary" id="patientSearchSubmit">
                    <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade"
     id="patientRegistrationModal"
     tabindex="-1"
     aria-labelledby="patientWizardTitle"
     aria-hidden="true"
     data-workflow-modal>
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content workflow-loading">
            <div class="modal-body text-center py-5" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <p class="mt-3 mb-0">Opening patient registration…</p>
            </div>
        </div>
    </div>
</div>

<div id="patientResults" aria-live="polite" aria-busy="false">
    @await Html.PartialAsync("_PatientResults", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#provinceFilter').change(function () {
                var provinceId = $(this).val();
                $('#districtFilter').empty().append('<option value="">All Districts</option>');
                $('#cityFilter').empty().append('<option value="">All Cities</option>');
                if (provinceId) {
                    $.get('/Patients/GetDistrictsByProvince', { provinceId: provinceId }, function (data) {
                        $.each(data, function (i, d) { $('#districtFilter').append($('<option>').val(d.id).text(d.name)); });
                    });
                }
            });

            $('#districtFilter').change(function () {
                var districtId = $(this).val();
                $('#cityFilter').empty().append('<option value="">All Cities</option>');
                if (districtId) {
                    $.get('/Patients/GetCitiesByDistrict', { districtId: districtId }, function (data) {
                        $.each(data, function (i, c) { $('#cityFilter').append($('<option>').val(c.id).text(c.name)); });
                    });
                }
            });

            // ---- Type-ahead patient search -------------------------------------
            // The Search button remains in the markup as the no-JS fallback, but it
            // is hidden once this handler takes over so typing alone drives results.
            var $form = $('#patientSearchForm');
            var $results = $('#patientResults');
            var $spinner = $('#patientSearchSpinner');
            var debounceTimer = null;
            var pending = null;
            var page = 1;

            $('#patientSearchSubmit').addClass('d-none');

            function currentQuery() {
                var params = {
                    searchString: $('#patientSearch').val(),
                    provinceId: $('#provinceFilter').val(),
                    districtId: $('#districtFilter').val(),
                    cityId: $('#cityFilter').val(),
                    centerId: $('#centerFilter').val(),
                    page: page
                };
                Object.keys(params).forEach(function (key) {
                    if (params[key] === '' || params[key] == null) { delete params[key]; }
                });
                return params;
            }

            function runSearch() {
                var params = currentQuery();
                if (pending) { pending.abort(); }
                $spinner.removeClass('d-none');
                $results.attr('aria-busy', 'true');

                pending = $.ajax({
                    url: '@Url.Action("Index", "Patients")',
                    data: params,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function (html) {
                    $results.html(html);
                    var query = $.param(params);
                    history.replaceState(null, '', query ? '?' + query : location.pathname);
                }).fail(function (xhr, status) {
                    if (status === 'abort') { return; }
                    $results.html('<div class="alert alert-danger mb-0">Search failed. Check your connection and try again.</div>');
                }).always(function () {
                    pending = null;
                    $spinner.addClass('d-none');
                    $results.attr('aria-busy', 'false');
                });
            }

            $('#patientSearch').on('input search', function () {
                page = 1;
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(runSearch, 300);
            });

            $('#provinceFilter, #districtFilter, #cityFilter, #centerFilter').on('change', function () {
                page = 1;
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(runSearch, 150);
            });

            // Keep pagination inside the live results instead of a full page load.
            $results.on('click', '.pagination .page-link', function (e) {
                e.preventDefault();
                var href = $(this).attr('href') || '';
                var match = /[?&]page=(\d+)/.exec(href);
                page = match ? parseInt(match[1], 10) : 1;
                runSearch();
                $('html, body').animate({ scrollTop: $results.offset().top - 80 }, 200);
            });

            // Enter inside the filter form should refresh in place, not reload.
            $form.on('submit', function (e) {
                e.preventDefault();
                page = 1;
                clearTimeout(debounceTimer);
                runSearch();
            });
        });
    </script>
}
