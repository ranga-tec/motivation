@model Poms.Domain.Entities.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<h1>Delete Patient</h1>
<div class="alert alert-danger">Are you sure you want to delete this patient? This is a soft delete and can be reversed by an administrator.</div>

<div class="card mb-3">
    <div class="card-body">
        <table class="table table-sm">
            <tr><th width="30%">Patient Number:</th><td>@Model.PatientNumber</td></tr>
            <tr><th>Full Name:</th><td>@Model.FullName</td></tr>
            <tr><th>Location:</th><td>@Model.Center.Name</td></tr>
        </table>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
