@model Poms.Web.ViewModels.PatientViewModel

@{
    var isEdit = string.Equals(ViewData["PatientFormMode"] as string, "edit", StringComparison.OrdinalIgnoreCase);
    var isModal = ViewData["PatientFormModal"] as bool? == true;
    var action = isEdit ? "Edit" : "Create";
    var title = isEdit ? "Edit patient" : "Register new patient";
    var eyebrow = isEdit ? $"Patient {Model.PatientNumber}" : "New patient";
    var submitLabel = isEdit ? "Save patient changes" : "Register patient";
    var cancelAction = isEdit ? "Folder" : "Index";
    var cancelRouteId = isEdit ? Model.Id : (Guid?)null;
    var dobValue = ViewData.ModelState[nameof(Model.Dob)]?.AttemptedValue
        ?? (Model.Dob == default ? "" : Model.Dob.ToString("yyyy-MM-dd"));
    var latestAllowedDob = DateTime.Today.AddDays(-3).ToString("yyyy-MM-dd");
}

<form asp-action="@action"
      asp-route-id="@(isEdit ? Model.Id : null)"
      method="post"
      enctype="multipart/form-data"
      class="modal-content workflow-wizard patient-wizard patient-registration-form"
      id="patientForm"
      data-patient-form
      data-modal-form="@isModal.ToString().ToLowerInvariant()"
      novalidate>
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PatientNumber" />
    }
    <input type="hidden" asp-for="ConfirmDuplicateWarning" id="confirmDuplicateWarning" />
    <input type="hidden" asp-for="IsLegacyImport" />
    <input type="hidden" asp-for="LegacyPatientFileNumber" />
    <input type="hidden" asp-for="OcrPreferredName" />
    <input type="hidden" asp-for="OcrOverallConfidence" />
    <input type="hidden" asp-for="OcrProvider" />
    <input type="hidden" asp-for="OcrImportToken" />
    @for (var warningIndex = 0; warningIndex < Model.OcrWarnings.Count; warningIndex++)
    {
        <input type="hidden" name="OcrWarnings[@warningIndex]" value="@Model.OcrWarnings[warningIndex]" />
    }

    <header class="modal-header workflow-header">
        <div>
            <span class="workflow-eyebrow">@eyebrow</span>
            <h1 class="modal-title h5 mb-1" id="patientWizardTitle">@title</h1>
            <p class="text-secondary small mb-0">Enter the patient’s identity, contact and registration information.</p>
        </div>
        @if (isModal)
        {
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close patient registration"></button>
        }
    </header>

    <div class="modal-body workflow-body">
        <nav class="registration-section-nav" aria-label="Patient registration sections">
            <span class="small text-secondary">Fields marked <span aria-hidden="true">*</span> are required</span>
            <div class="registration-section-links">
                <a href="#patientIdentitySection">Identity</a>
                <a href="#patientContactSection">Contact</a>
                <a href="#patientGuardianSection">Guardian</a>
                <a href="#patientRegistrationSection">Registration</a>
            </div>
        </nav>

        <div asp-validation-summary="All" class="alert alert-danger validation-summary-valid" role="alert" tabindex="-1"></div>

        @if (Model.IsLegacyImport)
        {
            <div class="alert alert-info" role="status">
                <h2 class="h6"><i class="fa-solid fa-wand-magic-sparkles me-2" aria-hidden="true"></i>OCR draft ready for review</h2>
                <p class="mb-2">
                    The scan has not created a patient record. Check every field, complete the required blanks,
                    and enter the original registration date before saving. The original scan will be attached
                    to the new patient folder when you save.
                </p>
                <dl class="row small mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.LegacyPatientFileNumber))
                    {
                        <dt class="col-sm-3">Legacy file number</dt>
                        <dd class="col-sm-9">@Model.LegacyPatientFileNumber</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OcrPreferredName))
                    {
                        <dt class="col-sm-3">Preferred name on form</dt>
                        <dd class="col-sm-9">@Model.OcrPreferredName</dd>
                    }
                    @if (Model.OcrOverallConfidence.HasValue)
                    {
                        <dt class="col-sm-3">Overall OCR confidence</dt>
                        <dd class="col-sm-9">@Model.OcrOverallConfidence.Value.ToString("P0")</dd>
                    }
                    @if (Model.OcrProvider.HasValue)
                    {
                        <dt class="col-sm-3">OCR method</dt>
                        <dd class="col-sm-9">@Model.OcrProvider</dd>
                    }
                </dl>
                @if (Model.OcrWarnings.Count > 0)
                {
                    <details class="mt-2">
                        <summary>Review @Model.OcrWarnings.Count OCR warning(s)</summary>
                        <ul class="mb-0 mt-2">
                            @foreach (var warning in Model.OcrWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }

        @if (ViewBag.ShowDuplicateWarning == true)
        {
            <div class="alert alert-warning duplicate-review" role="alert">
                <h2 class="h6">Possible matching patient</h2>
                <p class="mb-2">
                    <strong>@ViewBag.ExistingPatientNumber — @ViewBag.ExistingPatientName</strong>
                    has a similar name or date of birth. Check the details before creating another record.
                </p>
                <button type="button" class="btn btn-warning btn-sm" data-confirm-duplicate>Details checked — continue registration</button>
            </div>
        }

        <section id="patientIdentitySection" class="workflow-step registration-section" aria-labelledby="patientStepIdentity">
            <div class="workflow-section-heading">
                <h2 id="patientStepIdentity">Patient identity</h2>
                <p>Start with the details used to identify the patient and prevent duplicate records.</p>
            </div>

            <div class="patient-photo-card" data-patient-photo>
                <div class="patient-photo-preview" data-photo-preview>
                    <img src="@(Model.ExistingProfilePhotoUrl ?? "data:image/gif;base64,R0lGODlhAQABAAAAACw=")"
                         class="patient-photo-image @(Model.ExistingProfilePhotoUrl is null ? "d-none" : "")"
                         data-photo-image
                         alt="Current photo of @Model.FullName" />
                    <span class="patient-photo-placeholder @(Model.ExistingProfilePhotoUrl is null ? "" : "d-none")"
                          data-photo-placeholder
                          aria-hidden="true">
                        <i class="fa-solid fa-user"></i>
                    </span>
                </div>
                <div class="patient-photo-controls">
                    <label asp-for="ProfilePhoto" class="form-label mb-1"></label>
                    <p class="small text-secondary mb-2">Optional. Use a clear, recent head-and-shoulders photo.</p>
                    <input asp-for="ProfilePhoto"
                           type="file"
                           class="visually-hidden"
                           accept="image/jpeg,image/png"
                           data-photo-input
                           data-review-label="Patient photo" />
                    <input asp-for="RemoveProfilePhoto" type="hidden" data-remove-photo-value />
                    <div class="d-flex flex-wrap gap-2">
                        <label for="ProfilePhoto" class="btn btn-outline-primary mb-0" data-photo-choose>
                            <i class="fa-solid fa-camera me-1" aria-hidden="true"></i>
                            <span data-photo-choose-text>@(Model.ExistingProfilePhotoUrl is null ? "Choose photo" : "Replace photo")</span>
                        </label>
                        <button type="button"
                                class="btn btn-outline-danger @(Model.ExistingProfilePhotoUrl is null ? "d-none" : "")"
                                data-photo-remove>
                            Remove
                        </button>
                    </div>
                    <div class="form-text">JPG or PNG, up to 5 MB.</div>
                    <span asp-validation-for="ProfilePhoto" class="text-danger d-block"></span>
                    <p class="small text-success mt-2 mb-0 d-none" data-photo-status role="status"></p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-7">
                    <label asp-for="FullName" class="form-label required-label"></label>
                    <input asp-for="FullName" class="form-control" required autocomplete="name" data-review-label="Full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-lg-5">
                    <label asp-for="NameWithInitials" class="form-label required-label"></label>
                    <input asp-for="NameWithInitials" class="form-control" required autocomplete="nickname" data-review-label="Name with initials" />
                    <span asp-validation-for="NameWithInitials" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Dob" class="form-label required-label"></label>
                    <input name="Dob"
                           id="Dob"
                           class="form-control"
                           type="date"
                           value="@dobValue"
                           max="@latestAllowedDob"
                           required
                           data-val="true"
                           data-val-required="Date of birth is required."
                           autocomplete="bday"
                           data-review-label="Date of birth" />
                    <span asp-validation-for="Dob" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sex" class="form-label required-label"></label>
                    <select asp-for="Sex" class="form-select" required asp-items="ViewBag.SexOptions" data-review-label="Gender">
                        <option value="">Select gender</option>
                    </select>
                    <span asp-validation-for="Sex" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Employment" class="form-label"></label>
                    <input asp-for="Employment" class="form-control" autocomplete="organization-title" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label required-label"></label>
                    <select asp-for="Category" class="form-select" required asp-items="ViewBag.PatientCategories" data-review-label="Patient category"></select>
                </div>
                <div class="col-md-4" id="nationalityField">
                    <label asp-for="Nationality" class="form-label"></label>
                    <input asp-for="Nationality" class="form-control" autocomplete="country-name" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdentificationType" class="form-label required-label"></label>
                    <select asp-for="IdentificationType" class="form-select" required asp-items="ViewBag.IdentificationTypes"
                            data-identification-type data-review-label="Identification type"></select>
                    <div class="form-text">Choose N/A when the patient has no identification document.</div>
                </div>
                <div class="col-lg-6">
                    <label asp-for="IdentificationNumber" class="form-label required-label"></label>
                    <input asp-for="IdentificationNumber" class="form-control" autocomplete="off"
                           data-identification-number data-review-label="Identification number"
                           aria-describedby="identificationHint duplicateAlert" />
                    <div id="identificationHint" class="form-text">Enter the number exactly as shown on the document.</div>
                    <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
                    <div id="duplicateAlert" class="alert alert-warning mt-2 d-none" role="status"></div>
                </div>
            </div>
        </section>

        <section id="patientContactSection" class="workflow-step registration-section" aria-labelledby="patientStepContact">
            <div class="workflow-section-heading">
                <h2 id="patientStepContact">Contact and location</h2>
                <p>Record where the patient lives and the safest ways to contact them.</p>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Address1" class="form-label required-label"></label>
                    <input asp-for="Address1" class="form-control" required autocomplete="address-line1" data-review-label="Address" />
                    <span asp-validation-for="Address1" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address2" class="form-label"></label>
                    <input asp-for="Address2" class="form-control" autocomplete="address-line2" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ProvinceId" class="form-label required-label"></label>
                    <select asp-for="ProvinceId" class="form-select" required asp-items="ViewBag.Provinces" data-review-label="Province">
                        <option value="">Select province</option>
                    </select>
                    <span asp-validation-for="ProvinceId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DistrictId" class="form-label required-label"></label>
                    <select asp-for="DistrictId" class="form-select" required data-selected="@Model.DistrictId" data-review-label="District">
                        <option value="">Select district</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
                <div class="col-md-4" data-city-field>
                    <label asp-for="CityId" class="form-label"></label>
                    <select asp-for="CityId"
                            class="form-select"
                            data-selected="@Model.CityId"
                            data-searchable-city
                            data-review-label="City">
                        <option value="">Select city</option>
                    </select>
                    <div class="form-text">Search the selected district, or type a town not listed.</div>
                    <div class="city-other-fallback mt-2" data-city-other-fallback>
                        <label asp-for="CityOther" class="form-label"></label>
                        <input asp-for="CityOther" class="form-control" data-review-label="City" />
                        <div class="form-text">Only use this when the city is not in the list.</div>
                    </div>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                    <span asp-validation-for="CityOther" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="text" autocomplete="email" inputmode="email"
                           data-review-label="Email" aria-describedby="emailHint" />
                    <div id="emailHint" class="form-text">Enter N/A if the patient has no email address.</div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CenterId" class="form-label required-label"></label>
                    @if (isEdit)
                    {
                        <select asp-for="CenterId" class="form-select" disabled asp-items="ViewBag.Centers" data-review-label="Branch"></select>
                        <input type="hidden" asp-for="CenterId" />
                        <div class="form-text">The registration branch cannot be changed.</div>
                    }
                    else
                    {
                        <select asp-for="CenterId" class="form-select" required asp-items="ViewBag.Centers" data-review-label="Branch">
                            <option value="">Select branch</option>
                        </select>
                    }
                    <span asp-validation-for="CenterId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReferralSourceId" class="form-label"></label>
                    <select asp-for="ReferralSourceId" class="form-select" asp-items="ViewBag.ReferralSources">
                        <option value="">Select referral source (optional)</option>
                    </select>
                </div>
                <div class="col-12" id="referralOtherField">
                    <label asp-for="ReferralSourceOther" class="form-label"></label>
                    <input asp-for="ReferralSourceOther" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ReferralPersonName" class="form-label"></label>
                    <input asp-for="ReferralPersonName" class="form-control" autocomplete="name" data-review-label="Referral person" />
                    <div class="form-text">Optional.</div>
                    <span asp-validation-for="ReferralPersonName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReferralPersonContactNumber" class="form-label"></label>
                    <input asp-for="ReferralPersonContactNumber" class="form-control" autocomplete="tel" inputmode="tel" data-review-label="Referral contact" />
                    <div class="form-text">Optional.</div>
                    <span asp-validation-for="ReferralPersonContactNumber" class="text-danger"></span>
                </div>
            </div>

            <fieldset class="workflow-subsection mt-4">
                <legend class="h6">Telephone numbers</legend>
                <p class="small text-secondary">Add at least one number when available. Confirmation details are optional.</p>
                <div id="contactsContainer" class="vstack gap-3">
                    @for (var i = 0; i < Model.Contacts.Count; i++)
                    {
                        <div class="contact-row">
                            <input type="hidden" name="Contacts[@i].Id" value="@Model.Contacts[i].Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label" for="contactTelephone_@i">Telephone number</label>
                                    <input id="contactTelephone_@i" name="Contacts[@i].TelephoneNo" class="form-control" value="@Model.Contacts[i].TelephoneNo" autocomplete="tel" inputmode="tel" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="contactDate_@i">Date confirmed</label>
                                    <input id="contactDate_@i" name="Contacts[@i].DateConfirmed" type="date" class="form-control" value="@Model.Contacts[i].DateConfirmed?.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="contactPerson_@i">Confirmed by</label>
                                    <input id="contactPerson_@i" name="Contacts[@i].PersonChecked" class="form-control" value="@Model.Contacts[i].PersonChecked" autocomplete="name" />
                                </div>
                                <div class="col-md-1">
                                    <button type="button" class="btn btn-outline-danger w-100" data-remove-contact aria-label="Remove telephone number">
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" id="addContactBtn" class="btn btn-sm btn-outline-primary mt-3">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> Add another number
                </button>
            </fieldset>
        </section>

        <section id="patientGuardianSection" class="workflow-step registration-section" aria-labelledby="patientStepGuardian">
            <div class="workflow-section-heading">
                <h2 id="patientStepGuardian">Guardian or carer</h2>
                <p>Add the primary person supporting the patient.</p>
            </div>

            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="GuardianName" class="form-label required-label"></label>
                    <input asp-for="GuardianName" class="form-control" required autocomplete="name" data-review-label="Guardian or carer" />
                    <span asp-validation-for="GuardianName" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="GuardianRelationship" class="form-label required-label"></label>
                    <select asp-for="GuardianRelationship" class="form-select" required data-review-label="Relationship">
                        <option value="">Select relationship</option>
                        @foreach (var relationship in Poms.Web.ViewModels.PatientViewModel.GuardianRelationshipOptions)
                        {
                            <option value="@relationship">@relationship</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.GuardianRelationship) &&
                            !Poms.Web.ViewModels.PatientViewModel.GuardianRelationshipOptions.Contains(Model.GuardianRelationship))
                        {
                            <option value="@Model.GuardianRelationship">@Model.GuardianRelationship</option>
                        }
                    </select>
                    <span asp-validation-for="GuardianRelationship" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="GuardianAddress" class="form-label"></label>
                    <input asp-for="GuardianAddress" class="form-control" autocomplete="street-address" />
                </div>
                <div class="col-md-6">
                    <label asp-for="GuardianPhone" class="form-label"></label>
                    <input asp-for="GuardianPhone" class="form-control" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="GuardianPhone" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="GuardianMobile" class="form-label"></label>
                    <input asp-for="GuardianMobile" class="form-control" autocomplete="tel" inputmode="tel" data-review-label="Guardian mobile" />
                    <span asp-validation-for="GuardianMobile" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section id="patientRegistrationSection" class="workflow-step registration-section" aria-labelledby="patientStepRegistration">
            <div class="workflow-section-heading">
                <h2 id="patientStepRegistration">Registration details</h2>
                <p>Finish the administrative information for this registration.</p>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="AssignedClinicianEntry" class="form-label required-label"></label>
                    <input asp-for="AssignedClinicianEntry"
                           class="form-control"
                           list="patientAssigneeOptions"
                           required
                           autocomplete="off"
                           data-assignee-entry
                           data-review-label="Handled by" />
                    <input asp-for="AssignedClinicianUserId" type="hidden" data-assignee-user-id />
                    <datalist id="patientAssigneeOptions">
                        @foreach (var option in Model.AssigneeOptions)
                        {
                            <option value="@option.DisplayText" data-user-id="@option.UserId">
                                @(option.IsPreferred ? "Prosthetist / Orthotist" : "Staff")
                            </option>
                        }
                    </datalist>
                    <div class="form-text">Search staff by name, designation, or employee number. A custom name may also be entered.</div>
                    <span asp-validation-for="AssignedClinicianEntry" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TravelTimeDistance" class="form-label"></label>
                    <input asp-for="TravelTimeDistance" class="form-control" placeholder="For example, 45 minutes / 25 km" />
                </div>
                <div class="col-md-3">
                    <label asp-for="RegistrationDate" class="form-label"></label>
                    <input asp-for="RegistrationDate" class="form-control" type="date" readonly="@isEdit" data-review-label="Registration date" />
                    @if (isEdit)
                    {
                        <div class="form-text">The original registration date is read-only.</div>
                    }
                </div>
                <div class="col-md-3">
                    <label asp-for="RegistrationProcessedBy" class="form-label required-label"></label>
                    <input asp-for="RegistrationProcessedBy" class="form-control" required autocomplete="name" data-review-label="Processed by" />
                    <span asp-validation-for="RegistrationProcessedBy" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Remarks" class="form-label"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="4" data-review-label="Remarks"></textarea>
                </div>
            </div>
        </section>

        <div class="registration-privacy-note alert alert-info">
            <i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>
            Patient information is sensitive. Confirm that it matches the source documents before saving.
        </div>
    </div>

    <footer class="modal-footer workflow-footer">
        <div class="me-auto">
            @if (isModal)
            {
                <button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Close without saving</button>
            }
            else
            {
                <a asp-action="@cancelAction" asp-route-id="@cancelRouteId" class="btn btn-link text-secondary">Cancel</a>
            }
        </div>
        <p class="small text-secondary mb-0 me-2 d-none d-lg-block">Review required fields before saving.</p>
        <button type="submit" class="btn btn-success" data-form-submit>
            <i class="fa-solid fa-check me-1" aria-hidden="true"></i> @submitLabel
        </button>
    </footer>
</form>
