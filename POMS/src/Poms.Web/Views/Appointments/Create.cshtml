@model Poms.Web.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "New Appointment";
}

<h1>New Appointment</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="PatientId" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.PatientNumber))
        {
            <input type="hidden" asp-for="PatientId" />
            <p><strong>@Model.PatientNumber - @Model.PatientName</strong></p>
        }
        else
        {
            <select asp-for="PatientId" id="patientSelect" class="form-select"
                    data-combobox
                    data-combobox-endpoint="@Url.Action("SearchPatients", "Appointments")"
                    data-combobox-placeholder="Search by name, patient number or ID">
                <option value="">-- Select Patient --</option>
            </select>
            <div class="form-text">Start typing at least two characters to search.</div>
        }
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EpisodeId" class="form-label"></label>
        <select asp-for="EpisodeId" id="episodeSelect" class="form-select">
            <option value="">-- None / Not yet created --</option>
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<Poms.Domain.Enums.AppointmentType>()"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="AppointmentDate" class="form-label"></label>
            <input asp-for="AppointmentDate" class="form-control" type="date" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="AppointmentTime" class="form-label"></label>
            <input asp-for="AppointmentTime" class="form-control" type="time" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="AssignedClinicianEntry" class="form-label"></label>
        <select id="assigneeSelect" class="form-select"
                data-combobox
                data-combobox-text-target="AssignedClinicianEntry"
                data-combobox-placeholder="Search clinicians, or type a name"
                aria-describedby="assigneeHelp">
            <option value="">-- Select clinician --</option>
            @foreach (var option in Model.AssigneeOptions.OrderByDescending(o => o.IsPreferred).ThenBy(o => o.DisplayText))
            {
                <option value="@option.DisplayText"
                        data-user-id="@option.UserId"
                        data-detail="@(option.IsPreferred ? "Prosthetist / Orthotist" : "Staff")"
                        selected="@(option.DisplayText == Model.AssignedClinicianEntry)">@option.DisplayText</option>
            }
        </select>
        <input asp-for="AssignedClinicianEntry" type="hidden" />
        <input asp-for="AssignedClinicianUserId" type="hidden" />
        <div id="assigneeHelp" class="form-text">
            Search existing staff by name, designation or employee number — prosthetists and orthotists are listed first. If the person has no account, type their name and continue.
        </div>
        <span asp-validation-for="AssignedClinicianEntry" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Appointment</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            const assigneeSelect = document.getElementById('assigneeSelect');
            const assigneeEntry = document.getElementById('AssignedClinicianEntry');
            const assigneeUserId = document.getElementById('AssignedClinicianUserId');

            function syncAssignee() {
                const chosen = assigneeSelect.selectedOptions[0];
                if (chosen?.value) assigneeEntry.value = chosen.value;
                assigneeUserId.value = chosen?.dataset.userId || '';
            }

            assigneeSelect.addEventListener('change', syncAssignee);
            assigneeSelect.form.addEventListener('submit', syncAssignee);
            syncAssignee();

            function loadEpisodes(patientId) {
                $('#episodeSelect').empty().append('<option value="">-- None / Not yet created --</option>');
                if (patientId) {
                    $.get('/Appointments/GetEpisodesByPatient', { patientId: patientId }, function (data) {
                        $.each(data, function (i, e) {
                            const label = e.detail ? e.displayName + ' — ' + e.detail : e.displayName;
                            $('#episodeSelect').append($('<option>').val(e.id).text(label).attr('data-detail', e.detail || ''));
                        });
                    });
                }
            }
            $('#patientSelect').change(function () { loadEpisodes($(this).val()); });
            var preselected = '@Model.PatientId';
            if (preselected && preselected !== '00000000-0000-0000-0000-000000000000') {
                loadEpisodes(preselected);
            }
        });
    </script>
}
