@model IEnumerable<Poms.Domain.Entities.Appointment>

@{
    ViewData["Title"] = "Appointments";
    var typeOptions = Html.GetEnumSelectList<Poms.Domain.Enums.AppointmentType>().ToList();
    var typeLabels = typeOptions.ToDictionary(option => int.Parse(option.Value), option => option.Text);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Appointments / Date-Based Actions</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Appointment</a>
</div>

@if (ViewBag.Type == null)
{
    <p class="text-muted small">Delivery appointments are not shown here by default — track deliveries via <a asp-controller="Reports" asp-action="Delivery">Delivery Report</a> or the patient folder. Select "Delivery" below to view them in this list.</p>
}

<form asp-action="Index" method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All Types</option>
            @foreach (var option in typeOptions)
            {
                <option value="@option.Value" selected="@(ViewBag.Type?.ToString() == option.Value)">@option.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues(typeof(Poms.Domain.Enums.AppointmentStatus)))
            {
                <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped">
    <thead><tr><th>Date</th><th>Patient</th><th>Type</th><th>Prosthetist / Orthotist</th><th>Status</th><th>Notes</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.AppointmentDate.ToString("dd-MMM-yyyy") @a.AppointmentTime</td>
                <td>@a.Patient.PatientNumber - @a.Patient.FullName</td>
                <td>@typeLabels[(int)a.Type]</td>
                <td>@(a.AssignedClinicianName ?? "Not assigned")</td>
                <td>
                    <span class="badge @(a.Status == Poms.Domain.Enums.AppointmentStatus.Scheduled ? "bg-warning" : a.Status == Poms.Domain.Enums.AppointmentStatus.Completed ? "bg-success" : "bg-secondary")">
                        @a.Status
                    </span>
                </td>
                <td>@a.Notes</td>
                <td>
                    @if (a.Status == Poms.Domain.Enums.AppointmentStatus.Scheduled)
                    {
                        <form asp-action="Complete" asp-route-id="@a.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Done</button>
                        </form>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#cancelAppointment-@a.Id">
                            Cancel
                        </button>
                        <div class="modal fade"
                             id="cancelAppointment-@a.Id"
                             tabindex="-1"
                             aria-labelledby="cancelAppointmentLabel-@a.Id"
                             aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post">
                                        <div class="modal-header">
                                            <h2 class="modal-title fs-5" id="cancelAppointmentLabel-@a.Id">
                                                Cancel appointment
                                            </h2>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="text-secondary">
                                                This keeps the appointment in the patient history and marks it as cancelled.
                                            </p>
                                            <label for="cancellationReason-@a.Id" class="form-label">
                                                Cancellation reason <span aria-hidden="true">*</span>
                                            </label>
                                            <textarea id="cancellationReason-@a.Id"
                                                      name="cancellationReason"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="@Poms.Domain.Entities.Appointment.CancellationReasonMaxLength"
                                                      required></textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep appointment</button>
                                            <button type="submit" class="btn btn-danger">Cancel appointment</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else if (a.Status == Poms.Domain.Enums.AppointmentStatus.Cancelled)
                    {
                        <span class="small text-secondary">
                            @a.CancellationReason
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
