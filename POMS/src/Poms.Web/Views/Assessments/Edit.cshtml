@model Poms.Web.ViewModels.AssessmentViewModel

@{
    ViewData["Title"] = "Edit Assessment";
}

<h1>Edit Assessment</h1>
<p class="text-muted">Patient: <strong>@Model.PatientNumber - @Model.PatientName</strong></p>

<form asp-action="Edit" method="post" class="needs-validation">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EpisodeId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="AssessmentType" class="form-label"></label>
            <select asp-for="AssessmentType" id="assessmentType" class="form-select">
                <option value="Prosthetic">Prosthetic</option>
                <option value="Orthotic">Orthotic</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="LimbCategory" class="form-label"></label>
            <select asp-for="LimbCategory" id="limbCategory" class="form-select">
                <option value="UpperLimb">Upper Limb</option>
                <option value="LowerLimb">Lower Limb</option>
                <option value="Spinal" class="spinal-option">Spinal</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="AssessedOn" class="form-label"></label>
            <input asp-for="AssessedOn" class="form-control" type="date" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Side" class="form-label"></label>
            <select asp-for="Side" id="sideSelect" class="form-select">
                <option value="Left">Left</option>
                <option value="Right">Right</option>
                <option value="Bilateral">Bilateral</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MainProblemTypeId" class="form-label"></label>
            <select asp-for="MainProblemTypeId" class="form-select" asp-items="ViewBag.MainProblemTypes"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CauseReasonTypeId" class="form-label"></label>
            <select asp-for="CauseReasonTypeId" id="causeReasonSelect" class="form-select" asp-items="ViewBag.CauseReasonTypes"></select>
        </div>
    </div>
    <div class="mb-3" id="causeReasonOtherField">
        <label asp-for="CauseReasonOther" class="form-label"></label>
        <input asp-for="CauseReasonOther" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AdditionalInformation" class="form-label"></label>
        <textarea asp-for="AdditionalInformation" class="form-control" rows="3"></textarea>
    </div>

    <div id="singlePrescriptionBlock" class="card mb-3">
        <div class="card-header">Prescription</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <select name="PrescriptionCode" class="form-select prescription-select" data-selected="@Model.PrescriptionCode"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <select name="SubType" class="form-select subtype-select d-none" data-selected="@Model.SubType"></select>
                    <input name="OtherText" class="form-control other-text d-none mt-2" value="@Model.OtherText" placeholder="Please specify" />
                </div>
            </div>
        </div>
    </div>

    <div id="bilateralPrescriptionBlock" class="row d-none">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Prescription for Left</div>
                <div class="card-body">
                    <select name="LeftPrescriptionCode" class="form-select prescription-select" data-side="left" data-selected="@Model.LeftPrescriptionCode"></select>
                    <select name="LeftSubType" class="form-select subtype-select d-none mt-2" data-side="left" data-selected="@Model.LeftSubType"></select>
                    <input name="LeftOtherText" class="form-control other-text d-none mt-2" data-side="left" value="@Model.LeftOtherText" placeholder="Please specify" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Prescription for Right</div>
                <div class="card-body">
                    <select name="RightPrescriptionCode" class="form-select prescription-select" data-side="right" data-selected="@Model.RightPrescriptionCode"></select>
                    <select name="RightSubType" class="form-select subtype-select d-none mt-2" data-side="right" data-selected="@Model.RightSubType"></select>
                    <input name="RightOtherText" class="form-control other-text d-none mt-2" data-side="right" value="@Model.RightOtherText" placeholder="Please specify" />
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-warning">Update Assessment</button>
        <a asp-controller="Episodes" asp-action="Details" asp-route-id="@Model.EpisodeId" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleBilateral() {
                var bilateral = $('#sideSelect').val() === 'Bilateral';
                $('#singlePrescriptionBlock').toggleClass('d-none', bilateral);
                $('#bilateralPrescriptionBlock').toggleClass('d-none', !bilateral);
            }

            function toggleCauseOther() {
                var text = $('#causeReasonSelect option:selected').text();
                $('#causeReasonOtherField').toggle(text === 'Other');
            }

            function loadPrescriptionOptions($select) {
                var assessmentType = $('#assessmentType').val();
                var limbCategory = $('#limbCategory').val();
                var selected = $select.data('selected');
                $.get('/Assessments/GetPrescriptionOptions', { assessmentType: assessmentType, limbCategory: limbCategory }, function (data) {
                    $select.empty().append('<option value="">-- Select Prescription --</option>');
                    $.each(data, function (i, opt) {
                        var $o = $('<option>').val(opt.code).text(opt.label).data('subtypes', opt.subTypes);
                        $select.append($o);
                    });
                    if (selected) { $select.val(selected); }
                    $select.trigger('change');
                });
            }

            $('.prescription-select').on('change', function () {
                var $this = $(this);
                var side = $this.data('side') || '';
                var subTypes = $this.find('option:selected').data('subtypes');
                var $subSelect = side ? $('select.subtype-select[data-side="' + side + '"]') : $('#singlePrescriptionBlock .subtype-select');
                var $otherInput = side ? $('input.other-text[data-side="' + side + '"]') : $('#singlePrescriptionBlock .other-text');
                var subSelected = $subSelect.data('selected');

                if (subTypes && subTypes.length) {
                    $subSelect.empty().append('<option value="">-- Sub-type --</option>');
                    $.each(subTypes, function (i, st) { $subSelect.append($('<option>').val(st).text(st)); });
                    if (subSelected) { $subSelect.val(subSelected); }
                    $subSelect.removeClass('d-none');
                } else {
                    $subSelect.addClass('d-none').empty();
                }

                $otherInput.toggleClass('d-none', $this.val() !== 'OTHER');
            });

            $('#sideSelect').change(toggleBilateral);
            $('#causeReasonSelect').change(toggleCauseOther);

            toggleBilateral();
            toggleCauseOther();
            $('.prescription-select').each(function () { loadPrescriptionOptions($(this)); });
        });
    </script>
}
