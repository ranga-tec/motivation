{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PomsDb;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "UsePostgreSQL": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "FileStorage": {
    "RootPath": "C:\\PomsStorage",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".docx" ]
  },
  "PatientFormOcr": {
    "Enabled": true,
    "Endpoint": "https://api.openai.com/v1/responses",
    "Model": "gpt-4.1-mini-2025-04-14",
    "Offline": {
      "Enabled": true,
      "ExecutablePath": "tesseract",
      "Language": "eng",
      "TimeoutSeconds": 60
    }
  },
  "VersionSwitch": {
    "Current": "prototype",
    "PrototypeUrl": "",
    "ProductionUrl": ""
  },
  "AllowedHosts": "*"
}
