{
	# HTTP/3 (QUIC over UDP) failed on this network and left pages blank; serve HTTP/1.1 and HTTP/2 only.
	servers {
		protocols h1 h2
	}
}

{$POMS_DOMAIN} {
	encode zstd gzip

	@api path /api/* /auth/* /health
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
