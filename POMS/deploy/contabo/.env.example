# Copy to .env on the server and fill in. Never commit .env.
# Public hostname. sslip.io maps 169-58-173-191.sslip.io to 169.58.173.191 for free HTTPS;
# replace with your own domain later (point its A record at the server first).
POMS_DOMAIN=169-58-173-191.sslip.io
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# First administrator, created only when the database is empty. 12+ characters, upper, lower, number, symbol.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
